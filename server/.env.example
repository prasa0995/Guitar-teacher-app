# Copy to .env and fill in as needed.
PORT=3000

# Signs the login session cookie. Set a fixed random value in production
# (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
# so users stay logged in across redeploys.
SESSION_SECRET=

# Optional. If unset, the AI Tutor runs on its built-in rule-based engine
# (still fully context-aware) instead of calling the Anthropic API.
ANTHROPIC_API_KEY=
